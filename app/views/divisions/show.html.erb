<h1><%= @division.name %> Division</h1>
<p><%= @division.conference %> Conference</p>
<table class="table table-striped">
  <thead><tr><th>Team</th><th>W</th><th>L</th><th>OTL</th><th>Pts</th></tr></thead>
  <tbody>
    <% @teams.each do |team| %>
      <tr>
        <td><%= link_to team.name, team_path(team) %></td>
        <td><%= team.wins %></td>
        <td><%= team.losses %></td>
        <td><%= team.ot_losses %></td>
        <td><%= team.points %></td>
      </tr>
    <% end %>
  </tbody>
</table>