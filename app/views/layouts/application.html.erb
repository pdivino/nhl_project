<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "NHL App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "NHL App", root_path, class: "navbar-brand" %>
        <div class="navbar-nav">
          <%= link_to "Teams", teams_path, class: "nav-link" %>
          <%= link_to "Players", players_path, class: "nav-link" %>
          <%= link_to "Divisions", divisions_path, class: "nav-link" %>
          <%= link_to "About", about_path, class: "nav-link" %>
        </div>
      </div>
    </nav>
    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>